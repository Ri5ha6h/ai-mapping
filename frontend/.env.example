# Frontend environment example.
# Copy this file to frontend/.env for local development. Vite exposes only
# variables prefixed with VITE_ to browser code. Do not commit real secrets.

# FastAPI backend base URL used by the frontend API client.
# Default if omitted: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
