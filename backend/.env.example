# Backend environment example.
# Copy this file to backend/.env for local development, or export the values
# before starting FastAPI. Do not commit real secrets in backend/.env.

# Local SQLite database used for schema artifacts and mapping templates.
# Default if omitted: backend/data/templates.sqlite3.
# Relative paths are resolved from the backend directory.
TEMPLATE_DB_PATH=data/templates.sqlite3

# Comma-separated frontend origins allowed by FastAPI CORS middleware.
# Default if omitted: localhost/127.0.0.1 ports 3000 through 3005.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OpenRouter settings. Leave OPENROUTER_API_KEY empty to keep
# AI-assisted auto mapping disabled and use deterministic local suggestions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE='Auto Mapping POC'
